# aidaily runtime configuration
# Prefer ~/.config/aidaily/.env (mode 600) or process environment.

OPENROUTER_API_KEY=your_openrouter_api_key_here

# GPT Image 2.5 Batch fallback (paid OpenAI API; 50% Batch discount)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_IMAGE_BATCH_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_BATCH_SIZE=1536x864
# OPENAI_IMAGE_BATCH_QUALITY=high
# OPENAI_IMAGE_BATCH_WAIT_SECONDS=900

# OpenAI is the default runtime. Comma-separated fallbacks are optional.
LLM_MODELS=openai/gpt-6-luna,google/gemini-3.1-flash-lite
AI_NEWS_SUMMARY_MODEL=openai/gpt-6-luna

# Optional runtime/path overrides. Internal defaults come from _abot/services.json.
# INFOGRAPHIC_API_URL=http://127.0.0.1:8791/generate
# SEARCH_SERVICE_URL=http://127.0.0.1:8096
# AIDAILY_DATA_ROOT=/absolute/path/to/isolated/runtime-data
# AIDAILY_PUBLISHING_REPOSITORY=/Users/you/Sites/ai-infographic
# YOUTUBE_SUMMARIES_REPOSITORY=/Users/you/nlm-infographic
# YOUTUBE_SUMMARIES_CONFIG=/absolute/path/to/channel-config.json
# YOUTUBE_SUMMARIES_STATE=/absolute/path/to/processed-video-state.json

# Telegram notification (optional when the shared credential file is present)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: point to another protected env file.
# AIDAILY_ENV_FILE=/absolute/path/to/aidaily.env
