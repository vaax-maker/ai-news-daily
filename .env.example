# API Keys for AI News Daily
# Copy this file to .env and fill in your keys

# Primary summarizer (Grok) - Required
GROK_API_KEY=your_grok_api_key_here
# Optional: Specific model for Grok
GROK_MODEL=llama-3.3-70b-versatile

# Backup summarizer (Gemini) - Optional but recommended
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Specific model for Gemini
GEMINI_MODEL=gemini-2.0-flash

# Government API Key (data.go.kr)
# GOV_API_KEY=your_gov_api_key_here

# Keyword overrides (Optional)
# AI_KEYWORDS=LLM,GenAI,Robot
# XR_KEYWORDS=Vision Pro,Quest,Spatial Computing

# ============================================
# Rate Limiting (Free Tier Optimization)
# ============================================
# Minimum delay between API calls (seconds)
# Increase if hitting rate limits frequently
LLM_REQUEST_DELAY=2.0

# Maximum retry attempts for failed API calls
LLM_MAX_RETRIES=3

# Google Analytics (Optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

