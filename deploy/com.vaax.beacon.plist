<?xml version="1.0" encoding="UTF-8"?>
<!-- 오늘, 세상이 beacon — 매일 10:00 KST 로컬 발행 잡.
     설치:  cp deploy/com.vaax.beacon.plist ~/Library/LaunchAgents/
            launchctl load ~/Library/LaunchAgents/com.vaax.beacon.plist
     해제:  launchctl unload ~/Library/LaunchAgents/com.vaax.beacon.plist
     로그:  ~/ai-news-daily-beacon/data/beacon/run.log (+ launchd.out/err) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vaax.beacon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/woojanghoon/ai-news-daily-beacon/deploy/run_beacon.sh</string>
  </array>
  <!-- 매일 10:00 KST (Weekday 미지정 → 매일) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/woojanghoon/ai-news-daily-beacon/data/beacon/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/woojanghoon/ai-news-daily-beacon/data/beacon/launchd.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
